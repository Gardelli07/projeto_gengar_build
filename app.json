{
  "expo": {
    "name": "Lingueto",
    "slug": "lingueto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "scheme": [
      "lingueto",
      "com.shironora.lingueto"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shironora.lingueto",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/LogoIcon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.shironora.lingueto",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "extra": {
      "eas": {
        "projectId": "adf04d70-6502-43bd-ad45-ee81c68e305e"
      }
    },
    "plugins": [
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-font",
      "expo-video",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/LogoIcon.png",
          "color": "#3E6FB8"
        }
      ]
    ]
  }
}
